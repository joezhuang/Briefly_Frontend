# Backend API root, e.g. https://briefly-api.example.com
EXPO_PUBLIC_BRIEFLY_API_URL=

# Public web origin used for durable shared article URLs.
# IMPORTANT: do not set this to localhost in production.
# Example: https://briefly.example.com
EXPO_PUBLIC_BRIEFLY_WEB_URL=

# Public support address shown by Contact & Support.
EXPO_PUBLIC_BRIEFLY_SUPPORT_EMAIL=

# Optional preview mode for unpublished canonical article versions.
EXPO_PUBLIC_BRIEFLY_INCLUDE_DRAFTS=false

# TEST ONLY: exercise subscriber localization against the test backend.
# Never use this as production subscription authentication.
EXPO_PUBLIC_BRIEFLY_TEST_SUBSCRIBER=false

# Existing shared Briefly / Deeply Supabase project.
EXPO_PUBLIC_SUPABASE_URL=
# Prefer the current Supabase publishable key. The legacy anon key is also supported.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Native Briefly subscriptions (RevenueCat).
# These are public SDK keys, not secret backend keys.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=
EXPO_PUBLIC_REVENUECAT_ENTITLEMENT_ID=briefly_pro
# Optional; defaults to RevenueCat standard package identifiers.
# EXPO_PUBLIC_REVENUECAT_MONTHLY_PACKAGE_ID=$rc_monthly
# EXPO_PUBLIC_REVENUECAT_YEARLY_PACKAGE_ID=$rc_annual
